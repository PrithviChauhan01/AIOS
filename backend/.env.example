FLASK_ENV=development
PORT=5000
# Must be >= 32 bytes or the server refuses to start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_this
# Fernet key for the encrypted local vault (secret-tier data). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, the vault generates an ephemeral key and prints one to persist here.
VAULT_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PICOVOICE_API_KEY=
TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=
SQLITE_PATH=./db/aios.db
CHROMA_PATH=./db/chroma
VISION_ENABLED=false