# ── Server ──
# "production" disables uvicorn auto-reload
FLASK_ENV=development
# 0.0.0.0 to accept remote connections (e.g. EC2)
HOST=127.0.0.1
PORT=5000
# Must be >= 32 bytes or the server refuses to start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_this
# Owner login for POST /token (personal mode). Generate with scripts/setup_owner.py.
# Single-quote the hash — it contains '$'.
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=

# ── Public mode ──
# true → anonymous public demo: no JWT, in-memory sessions, all writing tools off,
# per-IP rate limit. The server refuses to boot unless SQLITE_PATH, CHROMA_PATH and
# VAULT_PATH below all point AWAY from the personal defaults.
PUBLIC_MODE=false

# ── Storage (relative paths anchor to backend/) ──
SQLITE_PATH=./db/aios.db
CHROMA_PATH=./db/chroma
# empty → vault table lives in SQLITE_PATH
VAULT_PATH=
# Fernet key for the encrypted local vault (secret-tier data). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, the vault generates an ephemeral key and prints one to persist here.
VAULT_KEY=

# ── Local model ──
OLLAMA_URL=http://localhost:11434

# ── LLM providers ──
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# ── Tools ──
TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=
# Gmail SMTP — use a Google App Password, not the account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── Reminders ──
# toast (Windows) | email (to GMAIL_ADDRESS) | log
NOTIFIER=toast
# optional; empty → built-in PowerShell AppUserModelID
AIOS_TOAST_APP_ID=

# ── Voice ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PICOVOICE_API_KEY=
VISION_ENABLED=false
# Set both to run voice/loop.py against a remote backend instead of in-process.
# e.g. https://aios.example.com
AIOS_API_URL=
# from POST {AIOS_API_URL}/token (owner login) — expires after 12h
AIOS_TOKEN=
